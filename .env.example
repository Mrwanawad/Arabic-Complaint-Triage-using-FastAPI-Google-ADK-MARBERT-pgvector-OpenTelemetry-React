# Copy to .env. Never commit real values.

# Compose
POSTGRES_PASSWORD=
REPLICATION_PASSWORD=

# Local run without Compose
# DATABASE_URL=postgresql://triage:password@localhost:5432/triage
# DATABASE_REPLICA_URL=

# Review and dashboard endpoints stay disabled until this is set
ADMIN_API_KEY=

# LLM providers: Gemini and Anthropic are primary, DeepSeek is the fallback
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Optional: send traces straight to Langfuse instead of a Collector
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Basic <base64 of public_key:secret_key>
